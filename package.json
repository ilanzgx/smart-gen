{
  "name": "@smart-gen/root",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter \"@smart-gen/*\" --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test:unit --reporter=tree",
    "check-all": "pnpm -r lint && pnpm -r type-check",
    "sync": "git pull --rebase --autostash && pnpm install",
    "ready": "pnpm run sync && pnpm run check-all"
  },
  "engines": {
    "node": ">=20.0"
  }
}
