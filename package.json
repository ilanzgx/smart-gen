{
  "name": "@smart-gen/root",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --filter \"@smart-gen/*\" --parallel dev",
    "build": "pnpm -r build",
    "build:web-mobile": "pnpm --filter @smart-gen/website build && pnpm --filter @smart-gen/mobile sync",
    "test": "pnpm -r test:unit --reporter=tree",
    "check-all": "pnpm -r lint && pnpm -r type-check && pnpm -r test:unit",
    "sync": "git pull --rebase --autostash && pnpm install",
    "ready": "pnpm run sync && pnpm run check-all",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "adm-zip": "^0.5.17",
    "husky": "^9.1.7"
  }
}
